# Real registration is fail-closed. Set these only for one explicitly authorized attempt.
RUN_MODE=real
REAL_SIGNUP_AUTHORIZED=false
REAL_SIGNUP_CONFIRMATION=
REGISTRANT_FULL_NAME=
REGISTRANT_DOB=YYYY-MM-DD
ACCOUNT_ENCRYPTION_KEY=

# Optional bounded Mail.tm polling parameters.
MAIL_POLL_MAX_ATTEMPTS=12
MAIL_POLL_INTERVAL_MS=5000
